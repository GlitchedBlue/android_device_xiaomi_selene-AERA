import /init.microtrust.rc

on init
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

    # The boot-control HAL's libaera_boot_trim LD_PRELOAD is scoped to the
    # service in recovery/root/system/etc/init/android.hardware.boot@1.2-service.rc,
    # NOT exported globally. A global preload of a /system path breaks every
    # dynamically linked binary (getprop, sh, zip installers) as soon as a zip
    # mounts the system partition over the ramdisk's /system. See that .rc for
    # the ABI background and the /sbin placement.

# Best-effort staging of the stock Android 13 Mali/HWC2 stack before init starts
# the recovery service. This rc is imported before init.rc's own `on boot`, so
# the boot actions run in parse order: this one first, then class_start default.
# The script only mounts/stages; it must not exec recovery itself.
#
# On selene this usually finds nothing: `vendor` is a logical partition inside
# `super` and is not mapped this early, so the script logs and exits and AERA
# keeps the software renderer. Run /system/bin/selene-gpu-test.sh by hand after
# mounting /vendor for the real dependency probe.
on boot
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/selene-gpu-launch.sh

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    wait /dev/block/mmcblk0boot0 2
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_ufs_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-1 /system/bin/android.hardware.keymaster@4.1-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:vendor.sys.listener.registered=true
    start gatekeeper-1-0
    start keymaster-4-1
   
on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-1
    stop gatekeeper-1-0
    
on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-1
    stop gatekeeper-1-0
        
on property:twrp.all.users.decrypted=true
    stop teei_daemon
    stop keymaster-4-1
    stop gatekeeper-1-0

# NOTE: The PBRP tree also starts `boot-hal-1-2` and `health-hal-2-1` here.
# Those services come from MTK packages that AERA 16 does not sync, and AERA's
# recovery init does not import /vendor/etc/init, so starting them would only
# produce "service not found" errors. Boot-control and health HAL bring-up is
# tracked in docs/PORTING-NOTES.md.
