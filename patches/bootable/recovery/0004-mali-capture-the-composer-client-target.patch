+// The Mali backend presents through HWC2, not through a DRM flip, so nothing
+// ever set presented_surface. gr_capture_source() then fell back to minui's
+// software canvas, which is never drawn while the GPU owns the UI: screenshots
+// came out as a valid PNG of pure black (7629 bytes at 1080x2400). Keep the
+// client target the composer just consumed, keyed by the caller's dma-buf fd,
+// and let gr_drm_get_presented_surface() map it on demand.
+extern "C" int gr_drm_note_presented_dmabuf(int dma_buf_fd, int width,
+                                            int height, int pitch,
+                                            uint32_t drm_format) {
+    static drm_surface* surfaces[2] = {nullptr, nullptr};
+    static int sources[2] = {-1, -1};
+    static int next_slot = 0;
+
+    if (dma_buf_fd < 0 || width <= 0 || height <= 0 || pitch <= 0)
+        return -EINVAL;
+
+    int slot = -1;
+    for (int i = 0; i < 2; ++i) {
+        if (sources[i] == dma_buf_fd) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0) {
+        slot = next_slot;
+        next_slot = (next_slot + 1) % 2;
+        if (surfaces[slot] != nullptr) {
+            drm_destroy_surface(surfaces[slot]);
+            surfaces[slot] = nullptr;
+        }
+        drm_surface* surface =
+            static_cast<drm_surface*>(calloc(1, sizeof(drm_surface)));
+        if (surface == nullptr) return -ENOMEM;
+        surface->dma_buf_fd = fcntl(dma_buf_fd, F_DUPFD_CLOEXEC, 0);
+        if (surface->dma_buf_fd < 0) {
+            free(surface);
+            return -errno;
+        }
+        surfaces[slot] = surface;
+        sources[slot] = dma_buf_fd;
+    }
+
+    drm_surface* surface = surfaces[slot];
+    surface->drm_format = drm_format;
+    surface->base.width = width;
+    surface->base.height = height;
+    surface->base.row_bytes = pitch;
+    surface->base.pixel_bytes = drm_format_to_bpp(drm_format) / 8;
+    surface->base.format = GGL_PIXEL_FORMAT_RGBA_8888;
+    surface->base.data = nullptr;
+    presented_surface = surface;
+    presented_buffer = -1;
+    return 0;
+}
