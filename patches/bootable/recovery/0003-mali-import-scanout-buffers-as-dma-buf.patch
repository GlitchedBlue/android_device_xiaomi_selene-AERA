+bool MaliDisplay::DescribeBuffer(unsigned index, int* fd, unsigned* stride) const {
+  const auto& state = *impl_;
+  if (!state.ready || index >= state.buffer_count || state.buffers[index] == nullptr)
+    return false;
+  // MediaTek's handle carries the gralloc_extra metadata descriptor first and
+  // the dma-buf second; on selene they read back as "anon_inode:gralloc_extra"
+  // and "/dmabuf:Gralloc". Only the second one can be imported by EGL.
+  if (state.buffers[index]->numFds < 2) return false;
+  if (fd != nullptr) *fd = state.buffers[index]->data[1];
+  if (stride != nullptr) *stride = static_cast<unsigned>(state.native[index].stride);
+  return true;
+}
